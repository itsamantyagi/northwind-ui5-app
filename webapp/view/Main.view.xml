<mvc:View controllerName="appat.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form">
    <Page id="page" title="{i18n>title}">
    <Panel id="PanelId" 
      headerText="Header Panel"
      class="sapUiResponsiveMargin"
      width="auto">
      <content>
       <Button id="ButtonReadId"   text="Read"   press="onRead"/> 
       <Button id="ButtonCreateId" text="Create" press="onCreate"/> 
       <Button id="ButtonUpdateId" text="Update" press="onUpdate"/> 
       <Button id="ButtonDeleteId" text="Delete" press="onDelete"/> 

       
        <form:SimpleForm id="employeeForm" title="Employees Details" editable="true">
            <Label id="_IDGenLabel" text="Employee Id"/>
            <Input id="empId" type="Number" />

            <Label id="_IDGenLabel1" text="Name"/>
            <Input id="name" />

            <Label id="_IDGenLabel2" text="City"/>
            <Input id="city" />

            <Label id="_IDGenLabel3" text="Company"/>
            <Input id="company" />

            <Label id="_IDGenLabel4" text="Department"/>
            <Input id="dept" />

            <Label id="_IDGenLabel5" text="Start Date"/>
            <Input id="startdate" />

            <Label id="_IDGenLabel6" text="End Date"/>
            <Input id="enddate" />

            <Label id="_IDGenLabel7" text="Salary"/>
            <Input id="salary" />

             <Label id="_IDGenLabel8" text="Currency"/>
            <Input id="currency" />
        </form:SimpleForm>

      </content>
  </Panel>
      <Panel id="PanelId1" 
      headerText="Employees Panel"
      class="sapUiResponsiveMargin"
      width="auto" >
     <content>
      <List id="ListId"
      headerText="Employees"
      class="sapUiResponsiveMargin"
      width="auto"
		items="{
             path : 'emp>/EmployeeSet'}"
         mode="SingleSelectMaster">
     <headerToolbar>
         <Toolbar id="_IDGenToolbar">
            <Title id="_IDGenTitle" text="Employees"/>
            <ToolbarSpacer id="_IDGenToolbarSpacer"/>
            <SearchField id="_IDGenSearchField" width="50%" search=".onFilterInvoices"/>
         </Toolbar>
      </headerToolbar>
		<items>
			<ObjectListItem id="_IDGenObjectListItem"
				title="{emp>Name}"
                number="{emp>Salary}"
                numberUnit="{emp>Currency}"
			/>
		</items>
   </List>
   </content>
      </Panel>
    </Page>
</mvc:View>


