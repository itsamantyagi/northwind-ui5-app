<mvc:View controllerName="appat.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form">
    <Page id="page" title="{i18n>title}">
    <Panel id="PanelId" 
      headerText="Header Panel"
      class="sapUiResponsiveMargin"
      width="auto">
      <content>
       <Button id="ButtonId" text="Read" press="onPress"/> 

       
        <form:SimpleForm id="employeeForm" title="Employees Details" editable="true">
            <Label id="_IDGenLabel" text="EmployeeId"/>
            <Input id="_IDGenInput" value="{selected>/EmployeeId}" />

            <Label id="_IDGenLabel1" text="EmployeeName"/>
            <Input id="_IDGenInput1" value="{selected>/Name}" />

            <Label id="_IDGenLabel2" text="Employee Salary"/>
            <Input id="_IDGenInput2" value="{selected>/Salary}" />
        </form:SimpleForm>

      </content>
  </Panel>
      <Panel id="PanelId1" 
      headerText="Employees Panel"
      class="sapUiResponsiveMargin"
      width="auto" >
     <content>
      <List id="ListId"
      headerText="Employees"
      class="sapUiResponsiveMargin"
      width="auto"
		items="{
             path : 'emp>/EmployeeSet'}"
         mode="SingleSelectMaster">
     <headerToolbar>
         <Toolbar id="_IDGenToolbar">
            <Title id="_IDGenTitle" text="Employees"/>
            <ToolbarSpacer id="_IDGenToolbarSpacer"/>
            <SearchField id="_IDGenSearchField" width="50%" search=".onFilterInvoices"/>
         </Toolbar>
      </headerToolbar>
		<items>
			<ObjectListItem id="_IDGenObjectListItem"
				title="{emp>Name}"
                number="{emp>Salary}"
                numberUnit="{emp>Currency}"
			/>
		</items>
   </List>
   </content>
      </Panel>
    </Page>
</mvc:View>


